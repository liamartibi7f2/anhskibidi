rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Admin = tài khoản có document admins/{uid}.
    // Document này CHỈ tạo được thủ công trong Firebase Console (client không ghi được).
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // Client chỉ được đọc đúng document của chính mình (để biết mình có phải admin không)
    match /admins/{id} {
      allow read: if isOwner(id);
      allow write: if false;
    }

    // Danh bạ người dùng: mỗi người tự ghi hồ sơ của mình, admin được đọc tất cả
    match /userDirectory/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
    }

    // Dữ liệu thu chi:
    //   - Chủ tài khoản: đọc + ghi
    //   - Admin: CHỈ ĐỌC (không có quyền write dù ở bất kỳ document nào)
    match /users/{uid}/cashflow/{doc} {
      allow read:  if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    // Lịch / Quản lý thời gian (module Time):
    //   - Chủ tài khoản: đọc + ghi
    //   - Admin: CHỈ ĐỌC (không có quyền create, update, delete)
    //   - Document phải đúng dạng { schema, json, updatedAt } và json không quá lớn
    match /users/{uid}/timeManagement/{doc} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['schema', 'json', 'updatedAt'])
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 940000;
      allow delete: if isOwner(uid);
    }

    // Thông báo trạng thái Admin đang xem:
    //   - Admin: đọc + ghi heartbeat/active
    //   - Chủ tài khoản: đọc + chỉ được cập nhật trường seenAt
    match /users/{uid}/adminAccess/{doc} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin()
                    || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']));
      allow delete: if isAdmin();
    }

    // Dữ liệu riêng của Personal-hub (Flashcards, Quiz, Focus, Pomodoro, Notes, Settings):
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/notes_store/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/notes_backup_vault/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/flashcard_store/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /users/{uid}/settings/{doc} {
      allow read, write: if isOwner(uid);
    }
    match /shared_quizzes/{code} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // COLLAB HUB — phòng giữ streak chung (module Cộng tác)
    //   rooms/{roomId}                       thông tin + luật phòng
    //   rooms/{roomId}/members/{uid}         hồ sơ + cam kết của từng người
    //   rooms/{roomId}/checkins/{uid_date}   mỗi người mỗi ngày đúng một check-in (BẮT BUỘC kèm ảnh)
    //   rooms/{roomId}/photos/{uid_date}     ảnh check-in (JPEG dataURL đã nén), tách riêng cho nhẹ
    //   rooms/{roomId}/nudges/{from_to_date} lời nhắc nhẹ
    //   invites/{code}                       mã mời → roomId
    //   users/{uid}/collab/rooms             danh sách phòng của mình
    // ─────────────────────────────────────────────────────────────
    function isRoomMember(roomId) {
      return signedIn() &&
        exists(/databases/$(db)/documents/rooms/$(roomId)/members/$(request.auth.uid));
    }
    function dayNum(t) { return t.year() * 10000 + t.month() * 100 + t.day(); }   // 20261124

    // Mã mời: chỉ đọc được từng mã một (không liệt kê) → phải biết mã mới vào được phòng
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.keys().hasOnly(['roomId', 'createdBy', 'createdAt']);
      allow list, update, delete: if false;
    }

    match /rooms/{roomId} {
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'maxHearts', 'regenDays', 'cutoff', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow read: if isRoomMember(roomId);
      // Chỉ chủ phòng đổi luật (số tim, số ngày hồi tim)
      allow update: if isRoomMember(roomId)
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['maxHearts', 'regenDays']);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isRoomMember(roomId);
        // Chủ phòng tạo hồ sơ cùng lúc với phòng; người khác phải kèm mã mời hợp lệ của đúng phòng này
        allow create: if signedIn() && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.keys().hasOnly(['uid', 'name', 'commits', 'joinedAt', 'code'])
                      && request.resource.data.name is string && request.resource.data.name.size() <= 24
                      && request.resource.data.commits is list && request.resource.data.commits.size() <= 60
                      && (getAfter(/databases/$(db)/documents/rooms/$(roomId)).data.ownerUid == uid
                          || get(/databases/$(db)/documents/invites/$(request.resource.data.code)).data.roomId == roomId);
        // Chỉ sửa hồ sơ của chính mình (cam kết, tên)
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.uid == uid
                      && request.resource.data.name is string && request.resource.data.name.size() <= 24
                      && request.resource.data.commits is list && request.resource.data.commits.size() <= 60;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Check-in: chỉ cho chính mình, giờ lấy từ máy chủ, mỗi (người, ngày) một tài liệu,
      // ngày ghi chỉ lệch tối đa ±1 ngày so với giờ máy chủ (chặn ghi bù xa),
      // và PHẢI có ảnh: tài liệu photos cùng id phải được ghi trong cùng batch (existsAfter)
      match /checkins/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['uid', 'date', 'day', 'at', 'note', 'late', 'hasPhoto'])
                      && request.resource.data.hasPhoto == true
                      && existsAfter(/databases/$(db)/documents/rooms/$(roomId)/photos/$(id))
                      && request.resource.data.uid == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.date
                      && request.resource.data.at == request.time
                      && request.resource.data.note is string && request.resource.data.note.size() <= 120
                      && request.resource.data.day in [dayNum(request.time - duration.value(1, 'd')),
                                                       dayNum(request.time),
                                                       dayNum(request.time + duration.value(1, 'd'))];
        // Hoàn tác: chỉ xoá check-in của mình trong vòng 5 phút
        allow delete: if isRoomMember(roomId)
                      && resource.data.uid == request.auth.uid
                      && resource.data.at > request.time - duration.value(5, 'm');
        allow update: if false;
      }

      // Ảnh check-in: chỉ chủ ảnh ghi, giờ máy chủ, dung lượng chuỗi ≤ 400k ký tự (~300KB)
      match /photos/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['uid', 'date', 'img', 'at'])
                      && request.resource.data.uid == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.date
                      && request.resource.data.at == request.time
                      && request.resource.data.img is string
                      && request.resource.data.img.size() <= 400000;
        // Hoàn tác cùng lúc với check-in (5 phút)
        allow delete: if isRoomMember(roomId)
                      && resource.data.uid == request.auth.uid
                      && resource.data.at > request.time - duration.value(5, 'm');
        allow update: if false;
      }

      match /nudges/{id} {
        allow read: if isRoomMember(roomId);
        allow create: if isRoomMember(roomId)
                      && request.resource.data.keys().hasOnly(['from', 'to', 'date', 'at'])
                      && request.resource.data.from == request.auth.uid
                      && id == request.auth.uid + '_' + request.resource.data.to + '_' + request.resource.data.date;
        allow update, delete: if false;
      }
    }

    // Danh sách phòng của mỗi người (riêng tư, chỉ chủ tài khoản)
    match /users/{uid}/collab/{doc} {
      allow read, write: if isOwner(uid);
    }

    // Nhật ký xem: admin tự ghi (chỉ được ghi bằng đúng uid của mình), không sửa/xóa được
    match /auditLogs/{id} {
      allow create: if isAdmin()
                    && request.resource.data.adminUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
